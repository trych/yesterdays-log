{
  "name": "yesterdays-log",
  "displayName": "Yesterday's Log",
  "description": "Hide old files in folders, showing only the most recent ones - perfect for logs and generated files",
  "version": "1.0.0",
  "publisher": "trych",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/trych/yesterdays-log"
  },
  "bugs": {
    "url": "https://github.com/trych/yesterdays-log/issues"
  },
  "homepage": "https://github.com/trych/yesterdays-log#readme",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#252526",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "files",
    "explorer",
    "hide",
    "logs",
    "recent"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Yesterday's Log",
      "properties": {
        "yesterdaysLog.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable or disable the **Yesterday's Log** extension"
        },
        "yesterdaysLog.rules": {
          "type": "array",
          "default": [],
          "markdownDescription": "Configure folder rules to limit visibility to the most recent files. Each rule needs a [glob pattern](https://code.visualstudio.com/docs/editor/glob-patterns) and a count or duration.\n\n```json\n[\n  { \"pattern\": \"**/logs\", \"show\": 3 },\n  { \"pattern\": \"**/output\", \"show\": \"7d\", \"exclude\": \"*.tmp\" }\n]\n```",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "pattern": {
                "type": "string",
                "markdownDescription": "Glob pattern to match folders (e.g., `**/logs`)"
              },
              "show": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  {
                    "type": "string",
                    "pattern": "^\\d+[mhdwMy]$"
                  }
                ],
                "default": 3,
                "markdownDescription": "Files to show: a **number** (e.g., `3`) for count, or a **duration** (e.g., `7d`, `2w`, `3M`) for age-based.\n\nUnits: `m` minutes, `h` hours, `d` days, `w` weeks, `M` months, `y` years"
              },
              "exclude": {
                "type": "string",
                "markdownDescription": "Glob pattern for files to always hide and exclude from counting (e.g., `*.tmp` for temporary files)"
              }
            },
            "required": ["pattern", "show"]
          }
        }
      }
    },
    "commands": [
      {
        "command": "yesterdaysLog.toggle",
        "title": "Yesterday's Log: Toggle On/Off"
      },
      {
        "command": "yesterdaysLog.addFolder",
        "title": "Yesterday's Log: Add Folder Rule"
      },
      {
        "command": "yesterdaysLog.openGlobalSettings",
        "title": "Yesterday's Log: Open Global Settings"
      },
      {
        "command": "yesterdaysLog.openProjectSettings",
        "title": "Yesterday's Log: Open Project Settings"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "yesterdaysLog.addFolder",
          "when": "explorerResourceIsFolder",
          "group": "z_yesterdaysLog"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "minimatch": "^9.0.3"
  }
}
